{
  "name": "@qwezey/typescript",
  "type": "module",
  "engines": {
    "node": "24"
  },
  "version": "2.0.1",
  "description": "An opinionated and strict ESLint, Prettier, and TypeScript configuration with a simple setup command to get you started quickly.",
  "exports": {
    ".": "./tsconfig.json",
    "./eslint": "./dist/eslint.js",
    "./prettier": "./dist/prettier.js"
  },
  "bin": {
    "qwezey-typescript": "./dist/bin/index.js"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "package.json",
    "README.md",
    "tsconfig.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npx -yp @vercel/ncc@latest build src/bin.ts -o dist/bin"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qwezey/typescript.git"
  },
  "keywords": [
    "typescript",
    "eslint",
    "prettier",
    "config",
    "opinionated",
    "strict"
  ],
  "author": "QweZey",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/qwezey/typescript/issues"
  },
  "homepage": "https://github.com/qwezey/typescript#readme",
  "dependencies": {
    "@eslint/js": "^10",
    "eslint": "^10",
    "eslint-config-prettier": "^10",
    "eslint-plugin-prettier": "^5",
    "jiti": "^2",
    "prettier": "^3",
    "typescript": "^5",
    "typescript-eslint": "^8"
  },
  "devDependencies": {
    "@actions/exec": "^3",
    "@types/node": "^24",
    "commander": "^14"
  }
}
